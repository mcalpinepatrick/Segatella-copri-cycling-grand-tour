#Human sequence and contaminant removal with Kneaddata
kneaddata --input1 001A.R1.fastq.gz --input-d 001A.R2.fastq.gz --db human_contaminant_database --output sample_5A --sequencer-source none --run-trim-repetitive --run-fastqc-start --run-fastqc-end

# All analysis was done within the qiime2 version amplicon-2023.9 environment

# Scaling with ranked subsampling (as an alternative to rarefaction)
qiime srs SRS --i-table qiita_output/genome.qza --p-
c-min 20379344  --o-normalized-table genomes_srs.qza

# Beta diversity
qiime diversity beta --i-table genomes_srs.qza --p-metric braycurtis --o-distance-matrix beta_diversity_braycurtis_srs.qza

qiime diversity beta-phylogenetic --i-table genomes_srs.qza --i-phylogeny WOL2/Phylogeny/wol2_tree.qza --p-metric weighted_unifrac --o-distance-matrix beta_diversity_weighted_unifrac_srs.qza

qiime diversity beta --i-table genome.qza --p-metric aitchison --o-distance-matrix beta_diversity_aitchison.qza

# Principle coordinate analysis
qiime diversity pcoa --i-distance-matrix beta_diversity_braycurtis_srs.qza --o-pcoa bray_curtis_srs_pcoa.qza
qiime emperor plot --i-bray_curtis_srs_pcoa.qza --m-metadata-file metadata.tsv --o-visualization curtis_srs_pcoa.qzv

# beta group significance
qiime diversity beta-group-significance --i-distance-matrix beta_diversity_braycurtis_srs_before.qza --m-metadata-file metadata.tsv --m-metadata-column cluster --p-pairwise True --o-visualization beta_group_significance_braycurtis_srs_before.qzv

# Alpha diversity
qiime diversity alpha --i-table genomes_srs.qza --p-metric shannon --o-alpha-diversity shannon_diversity.qza

# Paired-sample longitudinal beta diversity analysis
longitudinal pairwise-distances --i-Distance-Matrix beta_diversity_braycurtis_srs.qza --m-metadata metadata.tsv --m-group-column cluster --m-state-column time_point --m-state_1 one --m-state_2 two
--m-individual-id-column host_subject_id --o-visualization bray_curtis_change_per_cluster.qzv

# Collapsing gene coordinates to shared ontology information
woltka collapse -i qiita_output/genes.biom -m WOL2/Function/GO/orf-to-uniref.map.xz -o uniref_ids.biom

# MICOM model construction
qiime micom build --i-abundance genome.qza --i-taxonomy --wol2_taxonomy_correct_names.qza --p-cutoff 0.001 --p-threads 6 --o-community-models metabolic_model.qza --verbose 

# MICOM growth modeling (medium varied between western_diet_gut_agora.qza, vmh_high_fiber_agora.qza, and vmh_high_fat_low_carb_agora.qza)
qiime micom grow --i-models metabolic_model.qza --i-medium western_diet_gut_agora.qza --p-tradeoff 0.5 --p-threads 6 --o-results growth.qza --verbose

#MICOM export results
qiime micom exchanges-per-sample --i-results growth.qza --o-visualization exchanges.qzv
qiime micom exchanges-per-taxon --i-results growth.qza --o-visualization niche.qzv



