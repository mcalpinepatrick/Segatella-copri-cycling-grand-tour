  segments <- coords %>%
    arrange(sample_id, time_point) %>%
    group_by(sample_id) %>%
    summarise(
      x_start = PC1[time_point == "1"],
      y_start = PC2[time_point == "1"],
      x_end   = PC1[time_point == "2"],
      y_end   = PC2[time_point == "2"]
    ) %>%
    ungroup()
  
  # Function to shorten arrows
