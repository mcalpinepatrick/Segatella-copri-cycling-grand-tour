  # Load necessary libraries
  library(tidyverse)
  library(ggpubr)
  library(rstatix)
  
  # Load the data
  data <- read_tsv("shannon_change.tsv")
  
  #------------------------------------------
  # 1. Normality and variance tests per Cluster
  #------------------------------------------
  normality_baseline <- data %>%
    group_by(Cluster) %>%
    shapiro_test(Shannon_Baseline)
  
  normality_end <- data %>%
    group_by(Cluster) %>%
    shapiro_test(Shannon_end)
  
  levene_baseline <- data %>% levene_test(Shannon_Baseline ~ Cluster)
  levene_end <- data %>% levene_test(Shannon_end ~ Cluster)
  
  #------------------------------------------
  # 2. Test differences between Clusters (with pairwise)
  #------------------------------------------
  # Decide parametric or non-parametric
  if(all(normality_baseline$p > 0.05) & levene_baseline$p > 0.05){
    baseline_test <- data %>% anova_test(Shannon_Baseline ~ Cluster)
    baseline_pairwise <- data %>% pairwise_t_test(Shannon_Baseline ~ Cluster, p.adjust.method = "BH")
  } else {
    baseline_test <- data %>% kruskal_test(Shannon_Baseline ~ Cluster)
    baseline_pairwise <- data %>% pairwise_wilcox_test(Shannon_Baseline ~ Cluster, p.adjust.method = "BH")
  }
  
  if(all(normality_end$p > 0.05) & levene_end$p > 0.05){
    end_test <- data %>% anova_test(Shannon_end ~ Cluster)
    end_pairwise <- data %>% pairwise_t_test(Shannon_end ~ Cluster, p.adjust.method = "BH")
  } else {
    end_test <- data %>% kruskal_test(Shannon_end ~ Cluster)
    end_pairwise <- data %>% pairwise_wilcox_test(Shannon_end ~ Cluster, p.adjust.method = "BH")
  }
  
  #------------------------------------------
  # 3. Paired test for Baseline vs End per Cluster
  #------------------------------------------
  paired_tests <- data %>%
    group_by(Cluster) %>%
    summarise(
      test_result = list(
        if(shapiro.test(Shannon_end - Shannon_Baseline)$p.value > 0.05){
          t.test(Shannon_end, Shannon_Baseline, paired = TRUE)
        } else {
          wilcox.test(Shannon_end, Shannon_Baseline, paired = TRUE)
        }
      )
    )
  
  #------------------------------------------
  # 4. Mixed ANOVA for Cluster x Time interaction
  #------------------------------------------
  data_long <- data %>%
    pivot_longer(cols = c(Shannon_Baseline, Shannon_end),
                 names_to = "Time",
                 values_to = "Shannon") %>%
    mutate(Time = factor(Time, levels = c("Shannon_Baseline", "Shannon_end")))
  
  anova_mixed <- anova_test(
    data = data_long,
    dv = Shannon,
    wid = Subject,
    within = Time,
    between = Cluster
  )
  
  #------------------------------------------
  # 5. Summary table of results
  #------------------------------------------
  summary_table <- list(
    normality_baseline = normality_baseline,
    normality_end = normality_end,
    levene_baseline = levene_baseline,
    levene_end = levene_end,
    baseline_cluster_test = baseline_test,
    baseline_pairwise = baseline_pairwise,
    end_cluster_test = end_test,
    end_pairwise = end_pairwise,
    paired_tests = paired_tests,
    cluster_time_interaction = anova_mixed
  )
  
  print(summary_table)

