library(tidyverse)
library(lme4)
library(lmerTest)
library(emmeans)
library(pheatmap)

# ----------------------------
# 1. Load data
# ----------------------------

metabolites <- read.delim("metabolites_good.tsv", check.names = FALSE)
metadata <- read.delim("ciclistas_microbiota_all_metadata.tsv", check.names = FALSE)

common_samples <- intersect(metadata$sample_name, colnames(metabolites))
metadata <- metadata %>% filter(sample_name %in% common_samples)
metabolites <- metabolites %>% dplyr::select(Compound, all_of(common_samples))

# ----------------------------
# 2. Prepare matrix
# ----------------------------

met_mat <- metabolites %>%
  column_to_rownames("Compound") %>%
  as.matrix()

met_mat <- log2(met_mat + 1e-6)
met_mat_t <- t(met_mat)

analysis_df <- metadata %>%
  dplyr::select(sample_name, cluster, time_point, host_subject_id) %>%
  mutate(
    cluster = factor(cluster),
    time_point = factor(time_point),
    host_subject_id = factor(host_subject_id)
  )

# ----------------------------
# 3. Mixed model per metabolite
# ----------------------------

results_list <- list()
delta_list <- list()

for (i in 1:ncol(met_mat_t)) {
  
  df <- data.frame(
    abundance = met_mat_t[, i],
    analysis_df
  )
  
  fit <- try(lmer(abundance ~ time_point * cluster + 
                    (1 | host_subject_id), data = df),
             silent = TRUE)
  if (class(fit)[1] == "try-error") next
  
  anova_res <- anova(fit)
  
  global_p <- anova_res["time_point", "Pr(>F)"]
  interaction_p <- anova_res["time_point:cluster", "Pr(>F)"]
  
  # Within-cluster contrasts
  em <- emmeans(fit, ~ time_point | cluster)
  contr <- as.data.frame(pairs(em))
  
  for (j in 1:nrow(contr)) {
    delta_list[[length(delta_list) + 1]] <- data.frame(
      Metabolite = colnames(met_mat_t)[i],
      Cluster = contr$cluster[j],
      Delta_log2_T2_vs_T1 = contr$estimate[j],
      pvalue = contr$p.value[j]
    )
  }
  
  results_list[[i]] <- data.frame(
    Metabolite = colnames(met_mat_t)[i],
    Global_time_p = global_p,
    Interaction_p = interaction_p
  )
}

summary_df <- bind_rows(results_list)
delta_df <- bind_rows(delta_list)

# ----------------------------
# 4. FDR correction
# ----------------------------

summary_df$Global_FDR <- p.adjust(summary_df$Global_time_p, method = "fdr")
summary_df$Interaction_FDR <- p.adjust(summary_df$Interaction_p, method = "fdr")

delta_df <- delta_df %>%
  group_by(Cluster) %>%
  mutate(FDR = p.adjust(pvalue, method = "fdr")) %>%
  ungroup()

# Merge global + interaction info
delta_df <- delta_df %>%
  left_join(summary_df, by = "Metabolite")

write.table(delta_df,
            "global_longitudinal_interaction_results_good.tsv",
            sep = "\t",
            quote = FALSE,
            row.names = FALSE)

# ----------------------------
# 5. Select significant metabolites and build heatmap
# ----------------------------

# Step 5a: Identify metabolites to include
sig_global <- summary_df$Metabolite[summary_df$Global_FDR < 0.05]

sig_cluster <- delta_df %>%
  group_by(Metabolite) %>%
  filter(any(FDR < 0.05)) %>%
  pull(Metabolite) %>%
  unique()

sig_interaction <- summary_df$Metabolite[summary_df$Interaction_FDR < 0.05]

sig_mets <- unique(c(sig_global, sig_cluster, sig_interaction))

if (length(sig_mets) == 0) {
  message("No significant metabolites detected.")
} else {
  
  # Step 5b: Build delta matrix (T2 - T1)
  heatmap_df <- delta_df %>%
    filter(Metabolite %in% sig_mets) %>%
    dplyr::select(Metabolite, Cluster, Delta_log2_T2_vs_T1) %>%
    pivot_wider(names_from = Cluster,
                values_from = Delta_log2_T2_vs_T1)
  
  # Convert to numeric matrix
  met_names <- heatmap_df$Metabolite
  heatmap_df$Metabolite <- NULL
  heatmap_df[] <- lapply(heatmap_df, function(x) as.numeric(as.character(x)))
  heatmap_mat <- as.matrix(heatmap_df)
  rownames(heatmap_mat) <- met_names
  heatmap_mat <- heatmap_mat[rowSums(is.na(heatmap_mat)) != ncol(heatmap_mat), ]
  
  # Step 5c: Row annotation
  annotation_row <- summary_df %>%
    filter(Metabolite %in% sig_mets) %>%
    dplyr::select(Metabolite, Global_FDR, Interaction_FDR) %>%
    mutate(
      Global_change = factor(Global_FDR < 0.05, levels = c(TRUE, FALSE)),
      Interaction = factor(Interaction_FDR < 0.05, levels = c(TRUE, FALSE)),
      Cluster_specific = factor(Metabolite %in% sig_cluster, levels = c(TRUE, FALSE))
    )
  
  rownames(annotation_row) <- annotation_row$Metabolite
  annotation_row$Metabolite <- NULL
  
  # Align annotation rows
  annotation_row <- annotation_row[rownames(heatmap_mat), ]
  
  # ----------------------------
  # 5. Select significant metabolites and build heatmap
  # ----------------------------
  
  # Step 1: Identify significant metabolites
  
  # Make sure cluster-specific FDR is calculated
  delta_df <- delta_df %>%
    group_by(Cluster) %>%
    mutate(Cluster_FDR = p.adjust(pvalue, method = "fdr")) %>%
    ungroup()
  
  # Metabolites with any cluster-specific significant change
  sig_cluster <- delta_df %>%
    filter(Cluster_FDR < 0.05) %>%
    pull(Metabolite) %>%
    unique()
  
  # Metabolites with global or interaction significance
  sig_global <- summary_df$Metabolite[summary_df$Global_FDR < 0.05]
  sig_interaction <- summary_df$Metabolite[summary_df$Interaction_FDR < 0.05]
  
  # Combine all metabolites
  sig_mets <- unique(c(sig_global, sig_interaction, sig_cluster))
  
  if (length(sig_mets) == 0) {
    message("No significant metabolites detected.")
  } else {
    
    # Step 2: Build delta matrix
    heatmap_df <- delta_df %>%
      filter(Metabolite %in% sig_mets) %>%
      dplyr::select(Metabolite, Cluster, Delta_log2_T2_vs_T1) %>%
      pivot_wider(names_from = Cluster, values_from = Delta_log2_T2_vs_T1)
    
    met_names <- heatmap_df$Metabolite
    heatmap_df$Metabolite <- NULL
    heatmap_df[] <- lapply(heatmap_df, function(x) as.numeric(as.character(x)))
    heatmap_mat <- as.matrix(heatmap_df)
    rownames(heatmap_mat) <- met_names
    heatmap_mat <- heatmap_mat[rowSums(is.na(heatmap_mat)) != ncol(heatmap_mat), ]
    
    # Step 3: Row annotation with TRUE/FALSE only
    annotation_row <- summary_df %>%
      filter(Metabolite %in% sig_mets) %>%
      mutate(
        Global_change = Global_FDR < 0.05,
        Interaction = Interaction_FDR < 0.05,
        Cluster_specific = Metabolite %in% sig_cluster
      ) %>%
