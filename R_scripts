### make heatmap and venn diagram of differentially abundant ogu
# =========================
  # Load libraries
  # =========================
  library(tidyverse)
  library(pheatmap)
  
  # =========================
  # 1. Read files
  # =========================
  comparisons <- read_tsv("ogu_all_comparisons.tsv")
  abundance <- read_tsv("genomes_relative_before.tsv")
  metadata <- read_tsv("ciclistas_microbiota_all_metadata.tsv")
  
  # =========================
  # 2. Identify cluster-defining species
  # =========================
  species_AB <- comparisons %>% filter(Comparison == "A vs B") %>% pull(OGU) %>% unique()
  species_AC <- comparisons %>% filter(Comparison == "A vs C") %>% pull(OGU) %>% unique()
  species_BC <- comparisons %>% filter(Comparison == "B vs C") %>% pull(OGU) %>% unique()
  
  species_A <- intersect(species_AB, species_AC)
  species_B <- intersect(species_AB, species_BC)
  species_C <- intersect(species_AC, species_BC)
  
  species_overlap <- unique(c(species_A, species_B, species_C))
  
  # =========================
  # Venn diagram of differential-abundance sets
  # =========================
  library(ggVennDiagram)
  
  venn_sets <- list(
    AB = species_AB,
    AC = species_AC,
    BC = species_BC
  )
  
  ggVennDiagram(
    venn_sets,
    label_alpha = 0,
    label = "count"
  ) +
    scale_fill_gradient(low = "white", high = "steelblue") +
    labs(
      title = "Differentially abundant species across pairwise comparisons"
    ) +
    theme(
      plot.title = element_text(hjust = 0.5)
    )
  
  # =========================
  # 3. Subset abundance table
  # =========================
  abundance_sub <- abundance %>%
    filter(feature %in% species_overlap)
  
  abundance_mat <- abundance_sub %>%
    column_to_rownames("feature") %>%
    as.matrix()
  
  # =========================
  # 4. Log2 transform (add pseudocount)
  # =========================
  pseudocount <- 1e-6
  log_mat <- log2(abundance_mat + pseudocount)
  
  # =========================
  # 5. Z-score per species (row-wise)
  # =========================
  z_mat <- t(scale(t(log_mat)))
  
  # =========================
  # 6. Align metadata
  # =========================
  metadata <- metadata %>%
    filter(sample_name %in% colnames(z_mat))
  
  metadata <- metadata[match(colnames(z_mat), metadata$sample_name), ]
  
  # =========================
  # 7. Mean z-score per cluster
  # =========================
  cluster_levels <- sort(unique(metadata$cluster))
  
  cluster_means <- sapply(cluster_levels, function(cl) {
    rowMeans(z_mat[, metadata$cluster == cl, drop = FALSE])
  })
  
  cluster_means <- as.matrix(cluster_means)
  
  # =========================
  # 8. Optional: order rows by defining cluster
  # =========================
  defining_cluster <- case_when(
    rownames(cluster_means) %in% species_A ~ "A",
    rownames(cluster_means) %in% species_B ~ "B",
    rownames(cluster_means) %in% species_C ~ "C"
  )
  
  row_annotation <- data.frame(Cluster = defining_cluster)
  rownames(row_annotation) <- rownames(cluster_means)
  
  # =========================
  # 9. Plot heatmap
  # =========================
  cluster_means <- cluster_means[order(defining_cluster), ]
  row_annotation <- row_annotation[order(defining_cluster), , drop=FALSE]
  
  pheatmap(
    cluster_means,
    scale = "none",
    cluster_rows = TRUE,
    cluster_cols = FALSE,
    color = colorRampPalette(c("blue", "white", "red"))(100),
    main = "Cluster-defining species\nMean log2-relative abundance (z-scored)"
  )


### OGU longitudinal analysis
library(tidyverse)
  library(lme4)
  library(lmerTest)
  library(emmeans)
  library(pheatmap)
  
  # ----------------------------
  # 1. Load data
  # ----------------------------
  genomes <- read.delim("genome.tsv", check.names = FALSE)
  metadata <- read.delim("ciclistas_microbiota_all_metadata.tsv", check.names = FALSE)
  
  # ----------------------------
  # 2. Filter genomes
  # ----------------------------
  
  # Keep genomes with >=100 counts in >=4 samples
  genome_filtered <- genomes %>%
    rowwise() %>%
    filter(sum(c_across(-OTU_ID) >= 100) >= 4) %>%
    ungroup()
  
  # ----------------------------
  # 3. Normalize and log2 transform
  # ----------------------------
  
  genome_mat <- genome_filtered %>%
    column_to_rownames("OTU_ID") %>%
    as.matrix()
  
  # Relative abundance per sample
  genome_mat <- sweep(genome_mat, 2, colSums(genome_mat), FUN = "/")
  
  # Log2 transform with pseudocount
  genome_mat <- log2(genome_mat + 1e-6)
  
  # Transpose so rows = samples, columns = genomes
  genome_mat_t <- t(genome_mat)
  
  # ----------------------------
  # 4. Prepare metadata
  # ----------------------------
  analysis_df <- metadata %>%
    dplyr::select(sample_name, cluster, time_point, host_subject_id) %>%
    filter(sample_name %in% rownames(genome_mat_t)) %>%
    mutate(
      cluster = factor(cluster),
      time_point = factor(time_point),
      host_subject_id = factor(host_subject_id)
    )
  
  # Ensure row order matches matrix
  genome_mat_t <- genome_mat_t[analysis_df$sample_name, ]
  
  # ----------------------------
  # 5. Mixed model per genome
  # ----------------------------
  results_list <- list()
  delta_list <- list()
  
  for (i in 1:ncol(genome_mat_t)) {
    
    df <- data.frame(
      abundance = genome_mat_t[, i],
      analysis_df
    )
    
    fit <- try(lmer(abundance ~ time_point * cluster + 
                      (1 | host_subject_id), data = df),
               silent = TRUE)
    if (class(fit)[1] == "try-error") next
    
    anova_res <- anova(fit)
    
    global_p <- anova_res["time_point", "Pr(>F)"]
    interaction_p <- anova_res["time_point:cluster", "Pr(>F)"]
    
    # Within-cluster contrasts
    em <- emmeans(fit, ~ time_point | cluster)
    contr <- as.data.frame(contr <- as.data.frame(
      contrast(em, method = list("T2_minus_T1" = c(-1, 1)))
    ))
    
    for (j in 1:nrow(contr)) {
      delta_list[[length(delta_list) + 1]] <- data.frame(
        Genome = colnames(genome_mat_t)[i],
        Cluster = contr$cluster[j],
        Delta_log2_T2_vs_T1 = contr$estimate[j],
        pvalue = contr$p.value[j]
      )
    }
    
    results_list[[i]] <- data.frame(
      Genome = colnames(genome_mat_t)[i],
      Global_time_p = global_p,
      Interaction_p = interaction_p
    )
  }
  
  summary_df <- bind_rows(results_list)
  delta_df <- bind_rows(delta_list)
  
  # ----------------------------
  # 6. FDR correction
  # ----------------------------
  summary_df$Global_FDR <- p.adjust(summary_df$Global_time_p, method = "fdr")
  summary_df$Interaction_FDR <- p.adjust(summary_df$Interaction_p, method = "fdr")
  
  delta_df <- delta_df %>%
    group_by(Cluster) %>%
    mutate(FDR = p.adjust(pvalue, method = "fdr")) %>%
    ungroup()
  
  delta_df <- delta_df %>%
    left_join(summary_df, by = "Genome")
  
  write.table(delta_df,
              "genome_longitudinal_interaction_results.tsv",
              sep = "\t",
              quote = FALSE,
              row.names = FALSE)
  
  # ----------------------------
  # 7. Select significant genomes and build heatmap
  # ----------------------------
  # Identify genomes with global, interaction, or cluster-specific significance
  delta_df <- delta_df %>%
    group_by(Cluster) %>%
    mutate(Cluster_FDR = p.adjust(pvalue, method = "fdr")) %>%
    ungroup()
  
  sig_cluster <- delta_df %>%
    filter(Cluster_FDR < 0.05) %>%
    pull(Genome) %>%
    unique()
  
  sig_global <- summary_df$Genome[summary_df$Global_FDR < 0.05]
  sig_interaction <- summary_df$Genome[summary_df$Interaction_FDR < 0.05]
  
  sig_genomes <- unique(c(sig_global, sig_interaction, sig_cluster))
  
  if (length(sig_genomes) == 0) {
    message("No significant genomes detected.")
  } else {
    
    # Delta matrix for heatmap
    heatmap_df <- delta_df %>%
      filter(Genome %in% sig_genomes) %>%
      dplyr::select(Genome, Cluster, Delta_log2_T2_vs_T1) %>%
      pivot_wider(names_from = Cluster, values_from = Delta_log2_T2_vs_T1)
    
    genome_names <- heatmap_df$Genome
    heatmap_df$Genome <- NULL
    heatmap_df[] <- lapply(heatmap_df, function(x) as.numeric(as.character(x)))
    heatmap_mat <- as.matrix(heatmap_df)
    rownames(heatmap_mat) <- genome_names
    heatmap_mat <- heatmap_mat[rowSums(is.na(heatmap_mat)) != ncol(heatmap_mat), ]
    
    # Row annotation (TRUE/FALSE only)
    annotation_row <- summary_df %>%
      filter(Genome %in% sig_genomes) %>%
      mutate(
        Global_change = Global_FDR < 0.05,
        Interaction = Interaction_FDR < 0.05,
        Cluster_specific = Genome %in% sig_cluster
      ) %>%
      dplyr::select(Genome, Global_change, Interaction, Cluster_specific)
    
    rownames(annotation_row) <- annotation_row$Genome
    annotation_row$Genome <- NULL
    annotation_row <- annotation_row[rownames(heatmap_mat), ]
    annotation_row[] <- lapply(annotation_row, function(x) factor(x, levels = c(TRUE, FALSE)))
    
    # ----------------------------
    # 7b. Keep only top 50 most significant genomes for heatmap
    # ----------------------------
    
    # Compute minimum FDR across all tests for each genome
    genome_fdr <- summary_df %>%
      mutate(Min_FDR = pmin(Global_FDR, Interaction_FDR, na.rm = TRUE)) %>%
      dplyr::select(Genome, Min_FDR)
    
    # For cluster-specific FDRs
    cluster_min_fdr <- delta_df %>%
      group_by(Genome) %>%
      summarize(Cluster_min_FDR = min(Cluster_FDR, na.rm = TRUE), .groups = "drop")
    
    # Combine all
    genome_fdr <- genome_fdr %>%
      left_join(cluster_min_fdr, by = "Genome") %>%
      mutate(Overall_Min_FDR = pmin(Min_FDR, Cluster_min_FDR, na.rm = TRUE))
    
    # Keep top 50
    top50_genomes <- genome_fdr %>%
      arrange(Overall_Min_FDR) %>%
      slice_head(n = 50) %>%
      pull(Genome)
    
    # Filter heatmap matrix
    heatmap_mat <- heatmap_mat[rownames(heatmap_mat) %in% top50_genomes, ]
