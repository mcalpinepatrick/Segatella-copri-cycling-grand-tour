# ---- 1. Define input files and parameters ----
ko_file <- "ko_BvsC_all.csv"               # Ranked KOs: feature, coef
map_module  <- "module-to-ko.map"          # KEGG module map
map_pathway <- "pathway-to-ko.map"         # KEGG pathway map
output_prefix <- "gsea_kegg_BvsC_2"

padj_cutoff <- 0.05   # adjusted p-value threshold

# ---- 2. Load ranked KO table ----
ko_table <- fread(ko_file)
if(!all(c("feature","coef") %in% names(ko_table))) stop("KO CSV must have feature and coef columns")
ranks <- sort(setNames(ko_table$coef, ko_table$feature), decreasing = TRUE)
cat("Loaded", length(ranks), "KO features.\n")

# ---- 3. Load mapping files ----
load_kegg_map <- function(file){
  dt <- as.data.frame(fread(file, header = FALSE, sep = "\t", fill = TRUE, data.table = FALSE))
  if (ncol(dt) < 2) stop("Mapping file appears to have only one column. Check whitespace format.")
  
  sets <- lapply(seq_len(nrow(dt)), function(i) {
    x <- as.character(na.omit(dt[i, -1]))
    return(x)
  })
  names(sets) <- dt[[1]]
  return(sets)
}

module_sets <- load_kegg_map(map_module)
pathway_sets <- load_kegg_map(map_pathway)
cat("Modules:", length(module_sets), "Pathways:", length(pathway_sets), "\n")

# ---- 4. Filter sets ----
filter_sets <- function(sets, ranks){
  sets_filt <- lapply(sets, function(x) intersect(x, names(ranks)))
  sets_filt <- sets_filt[sapply(sets_filt,length) >= 5]
  return(sets_filt)
}

module_sets_f <- filter_sets(module_sets, ranks)
pathway_sets_f <- filter_sets(pathway_sets, ranks)
cat("Filtered sets: Modules=",length(module_sets_f),
    "Pathways=",length(pathway_sets_f),"\n")

# ---- 5. Run fgseaMultilevel ----
run_fgsea <- function(sets, ranks){
  fgseaMultilevel(
    pathways=sets,
    stats=ranks,
    minSize=5,
    maxSize=500,
    nproc    = 1
  ) %>% arrange(padj)
}

cat("Running GSEA for Modules...\n")
res_modules <- run_fgsea(module_sets_f, ranks)
cat("Running GSEA for Pathways...\n")
res_pathways <- run_fgsea(pathway_sets_f, ranks)


# ---- 7. Save results ----
fwrite(res_modules, paste0(output_prefix,"_modules.csv"))
fwrite(res_pathways, paste0(output_prefix,"_pathways.csv"))
cat("✅ Results saved for Modules and Pathways.\n")

# ---- 8. Volcano Plot Function ----
plot_gsea_volcano <- function(res, name_col, title_prefix, padj_thresh = 0.05, output_prefix = NULL){
  res <- as.data.frame(res)
  if (!all(c("NES", "padj") %in% names(res))) 
    stop("Input result must contain NES and padj columns.")
  
  res$label <- if (name_col %in% names(res)) as.character(res[[name_col]]) else as.character(res$pathway)
  res$label[is.na(res$label) | res$label == ""] <- res$pathway[is.na(res$label) | res$label == ""]
  
  res$status <- dplyr::case_when(
    is.na(res$padj) ~ "ns",
    res$padj >= padj_thresh ~ "ns",
    res$NES > 0 ~ "pos",
    res$NES < 0 ~ "neg",
    TRUE ~ "ns"
  )
  
  cols <- c("pos" = "#1f77b4", "neg" = "#d62728", "ns" = "grey70")
  
  nonzero <- res$padj[res$padj > 0]
  eps <- if (length(nonzero) > 0) min(nonzero, na.rm = TRUE)/10 else .Machine$double.xmin
  res$padj_plot <- ifelse(res$padj == 0, eps, res$padj)
  
  res$label_plot <- ifelse(res$padj < padj_thresh, res$label, "")
  
  title_text <- paste0(output_prefix, " – ", title_prefix, 
                       " GSEA Volcano Plot (padj <", padj_thresh, ")")
  
  p <- ggplot(res, aes(x = NES, y = -log10(padj_plot), color = status, label = label_plot)) +
    geom_point(size = 3, alpha = 0.8) +
    scale_color_manual(values = cols, guide = "none") +
    ggrepel::geom_text_repel(max.overlaps = 15, size = 3, box.padding = 0.4, segment.color = "grey60") +
    geom_vline(xintercept = 0, linetype = "dashed", color = "black") +
    geom_hline(yintercept = -log10(padj_thresh), linetype = "dotted", color = "black") +
    theme_minimal(base_size = 13) +
    labs(
      x = "Normalized Enrichment Score (NES)",
      y = "-log10(adjusted p-value)",
      title = title_text
    ) +
    theme(panel.grid.minor = element_blank())
  
  print(p)                               
                               


                               
